pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

export struct ProgramPolicy {
  minAge: Uint<16>;
  jurisdiction: Uint<16>;
  minHouseholdSize: Uint<16>;
  maxAnnualIncome: Uint<32>;
  active: Boolean;
}

struct AidCredential {
  age: Uint<16>;
  jurisdiction: Uint<16>;
  householdSize: Uint<16>;
  annualIncome: Uint<32>;
  credentialId: Bytes<32>;
}

export struct PublicClaim {
  programId: Bytes<32>;
  eligible: Boolean;
}

export new type UserSecret = Bytes<32>;
export new type AdminCommitment = Bytes<32>;

constructor() {
  contractAdmin = disclose(deriveAdminCommitment(getUserSecret()));
}

export ledger contractAdmin: AdminCommitment;
export ledger providers: Map<Uint<16>, JubjubPoint>;
export ledger programs: Map<Bytes<32>, ProgramPolicy>;
export ledger revokedCredentials: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger claims: Map<Bytes<32>, PublicClaim>;

witness getAttestedCredential(): [AidCredential, Schnorr_SchnorrSignature, Uint<16>];
witness getUserSecret(): UserSecret;

export pure circuit deriveAdminCommitment(secret: UserSecret): AdminCommitment {
  return persistentHash<[Bytes<17>, UserSecret]>(["aletheia:admin:v1", secret]) as AdminCommitment;
}

export pure circuit deriveProgramNullifier(secret: UserSecret, programId: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<21>, UserSecret, Bytes<32>]>(["aletheia:nullifier:v1", secret, programId]);
}

export pure circuit credentialRevocationHandle(credentialId: Bytes<32>, programId: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<29>, Bytes<32>, Bytes<32>]>(["aletheia:credential-revoke:v2", credentialId, programId]);
}

export circuit claim(programId: Bytes<32>): [] {
  const publicProgramId = disclose(programId);
  assert(programs.member(publicProgramId), "Unknown aid program");
  const policy = programs.lookup(publicProgramId);
  assert(policy.active, "Aid program is not active");

  const [credential, signature, providerId] = getAttestedCredential();
  const publicProviderId = disclose(providerId);
  assert(providers.member(publicProviderId), "Credential issuer is not approved");

  const secret = getUserSecret();
  const subjectHash = transientHash<UserSecret>(secret);
  const credentialIdHash = transientHash<Bytes<32>>(credential.credentialId);
  const message: Vector<6, Field> = [
    credential.age as Field,
    credential.jurisdiction as Field,
    credential.householdSize as Field,
    credential.annualIncome as Field,
    credentialIdHash,
    subjectHash
  ];
  Schnorr_schnorrVerify<6>(message, signature, providers.lookup(publicProviderId));

  const revocationHandle = disclose(credentialRevocationHandle(credential.credentialId, programId));
  assert(!revokedCredentials.member(revocationHandle), "Credential is revoked");
  assert(credential.age >= policy.minAge, "Age requirement not satisfied");
  assert(credential.jurisdiction == policy.jurisdiction, "Jurisdiction requirement not satisfied");
  assert(credential.householdSize >= policy.minHouseholdSize, "Household requirement not satisfied");
  assert(credential.annualIncome <= policy.maxAnnualIncome, "Income requirement not satisfied");

  const nullifier = disclose(deriveProgramNullifier(secret, programId));
  assert(!usedNullifiers.member(nullifier), "Program nullifier already used");
  usedNullifiers.insert(nullifier);
  claims.insert(nullifier, disclose(PublicClaim { programId: publicProgramId, eligible: true }));
}

export circuit configureProgram(programId: Bytes<32>, policy: ProgramPolicy): [] {
  assert(contractAdmin == deriveAdminCommitment(getUserSecret()), "Only admin can configure programs");
  programs.insert(disclose(programId), disclose(policy));
}

export circuit registerProvider(providerId: Uint<16>, providerPk: JubjubPoint): [] {
  assert(contractAdmin == deriveAdminCommitment(getUserSecret()), "Only admin can register issuers");
  providers.insert(disclose(providerId), disclose(providerPk));
}

export circuit revokeCredential(programId: Bytes<32>, credentialId: Bytes<32>): [] {
  assert(contractAdmin == deriveAdminCommitment(getUserSecret()), "Only admin can revoke credentials");
  assert(programs.member(disclose(programId)), "Unknown aid program");
  revokedCredentials.insert(disclose(credentialRevocationHandle(credentialId, programId)));
}

export circuit rotateAdmin(nextAdmin: AdminCommitment): [] {
  assert(contractAdmin == deriveAdminCommitment(getUserSecret()), "Only admin can rotate admin");
  contractAdmin = disclose(nextAdmin);
}

export pure circuit schnorrChallenge(
  ann_x: Field,
  ann_y: Field,
  pk_x: Field,
  pk_y: Field,
  msg: Vector<6, Field>
): Field {
  return Schnorr_schnorrChallenge<6>(ann_x, ann_y, pk_x, pk_y, msg);
}
